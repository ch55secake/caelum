{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caelum",
  "version": "0.1.0",
  "identifier": "dev.caelum.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../.. --filter @caelum/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../../.. --filter @caelum/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caelum — Your code. New horizons.",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 620
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A native home for AI coding agents"
  }
}
