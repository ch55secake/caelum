class CaelumCli < Formula
  desc "Command-line interface for the Caelum coding workspace"
  homepage "https://github.com/ch55secake/caelum"
  version "$VERSION"
  license "MIT"

  depends_on :macos

  on_macos do
    on_arm do
      url "https://github.com/ch55secake/caelum/releases/download/v#{version}/caelum-cli-v#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "$AARCH64_CLI_SHA256"
    end

    on_intel do
      url "https://github.com/ch55secake/caelum/releases/download/v#{version}/caelum-cli-v#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "$X86_64_CLI_SHA256"
    end
  end

  def install
    bin.install "caelum"
  end

  test do
    assert_match "caelum #{version}", shell_output("#{bin}/caelum --version")
  end
end
